NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://mythbase:mythbase@localhost:5432/mythbase
TEST_DATABASE_URL=postgres://mythbase:mythbase@localhost:5432/mythbase_test
DB_SSL=false

# Миграции при запуске
RUN_MIGRATIONS=false

# Разрешённые источники запросов
CORS_ORIGINS=http://localhost:3000

# Ограничения запросов
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
