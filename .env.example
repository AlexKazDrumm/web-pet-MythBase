# PostgreSQL
POSTGRES_USER=mythbase
POSTGRES_PASSWORD=mythbase
POSTGRES_DB=mythbase
POSTGRES_PORT=5432

# Порты API и клиента
API_PORT=4000
WEB_PORT=3000

# Адрес API в браузере
NEXT_PUBLIC_API_URL=http://localhost:4000

# Внешняя база для API в Docker; пустое значение использует сервис db
API_DATABASE_URL=
RUN_MIGRATIONS=true

# Разрешить seed заменить существующие записи
SEED_FORCE=false
